{
  "manifest_version": 3,
  "name": "YouTube Experience Enhancer",
  "version": "0.1",
  "description": "Adjust the number of video columns on YouTube",
  "author": "TuanMinPay",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["styles.css", "youtube-ui-mod.css"],
      "js": [
        "content.js",
        "youtube-ui-mod.js",
        "playlist-resize.js",
        "keyboard-shortcuts.js",
        "tooltip.js",
        "guide-siblings-hide.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
